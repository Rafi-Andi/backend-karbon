APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=1_challange_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI validasi foto sampah (server-side). Wajib key asli + AI_MOCK=false. ---
# AI_DRIVER=gemini  → Google AI Studio / Vertex AI Express (auth ?key=, default)
# AI_DRIVER=openai  → endpoint OpenAI-compatible (Groq/OpenRouter/DeepSeek/OpenAI)
AI_DRIVER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_MIN_CONFIDENCE=85
AI_MOCK=true
# --- Contoh: Groq (gratis, tanpa kartu kredit, terbukti jalan dari VPS) ---
#   AI_DRIVER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=qwen/qwen3.8-27b
#   AI_API_KEY=gsk_...
#   AI_MOCK=false
# --- IP VPS diblokir Google ("User location is not supported for the API use")?
# Google menolak IP datacenter/VPS, termasuk Cloudflare Worker (hanya sebagian
# IP-nya lolos). Solusinya AI_DRIVER=openai di atas, atau salah satu ini: ---
#   --- Vertex AI Express Mode (API key, tanpa service account) ---
#   AI_BASE_URL=https://aiplatform.googleapis.com
#   AI_ENDPOINT_PATH=/v1/publishers/google/models/{model}:generateContent
#   AI_API_KEY=<express mode key>  (AI_MODEL tetap gemini-3.5-flash-lite)
#   --- Relay/proxy sendiri ---
#   AI_PROXY=http://user:pass@host:port
#   AI_BASE_URL=https://relay.contoh.id
#   AI_RELAY_KEY=rahasia-relay
# Env GEMINI_* lama tetap dibaca sebagai fallback saat AI_DRIVER=gemini.
WASTE_MAX_IMAGE_KB=5120

XENDIT_API_KEY=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_MOCK=true
# Opsional: namespace key payout. Kosong = otomatis dari APP_ENV
# (production→PROD, local→LOCAL). Isi manual bila perlu.
# XENDIT_KEY_PREFIX=
XENDIT_TIMEOUT=20
XENDIT_CALLBACK_TOKEN=
XENDIT_WEBHOOK_SECRET=
XENDIT_RETRY_ATTEMPTS=3
XENDIT_RETRY_DELAY=300

MITRA_MAX_FILE_KB=5120

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=karbonkita
CLOUDINARY_MOCK=false
CLOUDINARY_TIMEOUT=30

# Token halaman monitoring akses juri (/monitoring?token=...).
# Kosong = halaman nonaktif. Pakai string acak yang panjang.
MONITORING_TOKEN=

ECO_RUPIAH_PER_POINT=40

DONATION_MIN_AMOUNT=10000
XENDIT_INVOICE_DURATION=86400
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=

# ============================================================
# KarbonKita — ENV PRODUKSI (untuk Docker Compose)
# Salin jadi `.env` di VPS, lalu isi semua nilai bertanda GANTI.
# JANGAN commit file `.env` asli.
# ============================================================

APP_NAME=KarbonKita
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mage.pemudasintaks.web.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (service `db` di compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=karbonkita
DB_USERNAME=karbonkita
DB_PASSWORD=GANTI_PASSWORD_DB_KUAT
# Dipakai mysql:8 untuk init; wajib ada di compose.
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

# --- Sesi & cache (database, tanpa Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@karbonkita.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Reverse proxy (CloudPanel) ---
# Port localhost tempat container `web` (nginx) listen. CloudPanel membuat
# Reverse Proxy domain https://mage.pemudasintaks.web.id -> http://127.0.0.1:WEB_PORT
# Cek dulu di VPS: sudo ss -tlnp | grep ':8080' (kosong = aman). Jika terisi,
# ganti ke 8081/8082 dst.
WEB_PORT=8080

# --- AI Gemini (server-side). Tetap mock sampai key asli siap. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MIN_CONFIDENCE=85
GEMINI_MOCK=true
WASTE_MAX_IMAGE_KB=5120

# --- Xendit (payout). Go-live: mock=false + key & callback token LIVE. ---
XENDIT_API_KEY=GANTI_SECRET_KEY_LIVE
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_MOCK=false
XENDIT_TIMEOUT=20
XENDIT_CALLBACK_TOKEN=GANTI_CALLBACK_TOKEN_LIVE
XENDIT_WEBHOOK_SECRET=
XENDIT_RETRY_ATTEMPTS=3
XENDIT_RETRY_DELAY=300

MITRA_MAX_FILE_KB=5120

DONATION_MIN_AMOUNT=10000
XENDIT_INVOICE_DURATION=86400
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=

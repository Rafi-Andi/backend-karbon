# ============================================================
# KarbonKita — ENV PRODUKSI (untuk Docker Compose)
# Salin jadi `.env` di VPS, lalu isi semua nilai bertanda GANTI.
# JANGAN commit file `.env` asli.
#
# Dua mode deploy (detail di DEPLOY.md):
#   1) VPS tanpa panel  -> docker compose --profile caddy up -d --build
#      Isi APP_URL + APP_DOMAIN; Caddy mengurus HTTPS otomatis.
#   2) VPS ber-CloudPanel -> docker compose up -d --build
#      Buat site + Reverse Proxy domain ke http://127.0.0.1:${WEB_PORT}.
# ============================================================

APP_NAME=KarbonKita
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://karbon.pemudasintaks.web.id
# Domain untuk sertifikat HTTPS mode Caddy (tanpa https:// dan tanpa /).
# Abaikan bila memakai mode CloudPanel. GANTI bila memakai domain lain.
APP_DOMAIN=karbon.pemudasintaks.web.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (service `db` di compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=karbonkita
DB_USERNAME=karbonkita
DB_PASSWORD=GANTI_PASSWORD_DB_KUAT
# Dipakai mysql:8 untuk init; wajib ada di compose.
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

# --- Sesi & cache (database, tanpa Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@karbonkita.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Reverse proxy / port container `web` ---
# Mode CloudPanel: target Reverse Proxy site -> http://127.0.0.1:WEB_PORT.
# Mode Caddy: tidak perlu diubah (Caddy mengakses `web:80` via network internal).
# Cek dulu di VPS: sudo ss -tlnp | grep ':8080' (kosong = aman). Jika terisi,
# ganti ke 8081/8082 dst.
WEB_PORT=8080

# --- AI Gemini (server-side). Tetap mock sampai key asli siap. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MIN_CONFIDENCE=85
GEMINI_MOCK=true
WASTE_MAX_IMAGE_KB=5120

# --- Xendit (payout). Go-live: mock=false + key & callback token LIVE. ---
XENDIT_API_KEY=GANTI_SECRET_KEY_LIVE
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_MOCK=false
# Opsional: namespace key payout. Kosong = otomatis PROD dari APP_ENV=production.
# Isi manual hanya bila dua VPS production berbagi satu API key.
# XENDIT_KEY_PREFIX=
XENDIT_TIMEOUT=20
XENDIT_CALLBACK_TOKEN=GANTI_CALLBACK_TOKEN_LIVE
XENDIT_WEBHOOK_SECRET=
XENDIT_RETRY_ATTEMPTS=3
XENDIT_RETRY_DELAY=300

# --- Cloudinary (upload foto mitra & produk, di service-side) ---
# Dibiarkan kosong = mode mock otomatis: foto menjadi placeholder tetapi
# registrasi mitra tetap jalan (cocok untuk demo). Untuk upload asli,
# daftar gratis di cloudinary.com lalu isi tiga nilai pertama.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=karbonkita
CLOUDINARY_MOCK=false
CLOUDINARY_TIMEOUT=30

# Token halaman monitoring akses juri (/monitoring?token=...).
# WAJIB diisi di produksi; kosong = halaman nonaktif (404).
# Generate: openssl rand -hex 16
MONITORING_TOKEN=

MITRA_MAX_FILE_KB=5120

DONATION_MIN_AMOUNT=10000
XENDIT_INVOICE_DURATION=86400
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=
